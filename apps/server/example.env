NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis (Upstash)
UPSTASH_REDIS_HOST=your-upstash-redis-host.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# Redis (Render - alternative to Upstash, comment out if using Upstash)
# REDIS_HOST=your-redis-instance.onrender.com
# REDIS_PORT=6379

RESEND_API_KEY=Your key
FROM_EMAIL=Cronix <onboarding@resend.dev>